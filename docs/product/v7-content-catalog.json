  "owner_decisions": {
    "D1": {
      "choice": "c",
      "provisional": false,
      "summary": "Always show at least three Findings; apply the score gate to slots four and five only."
    },
    "D2": {
      "choice": "c",
      "provisional": false,
      "summary": "Drop the slight / moderate / pronounced bands entirely. A Finding carries direction, score and a shrunk estimate with an interval, and no adjective. CALIBRATION_RESERVED is not spent on this."
    },
    "D3": {
      "choice": "a",
      "provisional": false,
      "summary": "Keep the modal-sign cut at 0.95."
    },
    "D4": {
      "choice": "a",
      "provisional": false,
      "summary": "Ship all sixteen dimensions carrying between-player signal. Reliability shrinkage is the only gate; no second hard reliability cutoff."
    },
    "D5": {
      "choice": "a",
      "provisional": false,
      "summary": "Keep early / mid / late."
    },
    "D6": {
      "choice": "a",
      "provisional": true,
      "summary": "Ship The Lighthouse and The Closer. Both stay positive and shareable."
    },
    "D7": {
      "choice": "a",
      "provisional": false,
      "summary": "Keep fifteen per arm. Settled by the DISCOVERY sensitivity sweep; CALIBRATION_RESERVED is not spent on this."
    },
    "D8": {
      "choice": "a",
      "provisional": false,
      "summary": "Spend CALIBRATION_RESERVED on calibration. SEALED_VALIDATION stays untouched and is opened only on the owner's express approval."
    },
    "D9": {
      "choice": "a",
      "provisional": false,
      "summary": "Full-depth acquisition for every pilot user. Persist the acquired and derived data so repeat report generation, account creation and paid output all reuse it rather than refetching. Paid quality must not depend on having analysed more matches during the pilot."
    }
  },
