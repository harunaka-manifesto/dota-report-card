# Local defaults. Production must override the deployment-critical values.
APP_ENV=development
LOG_LEVEL=INFO
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
OPENDOTA_MAX_RETRIES=3
OPENDOTA_TIMEOUT_SECONDS=15
FREE_HISTORY_LIMIT=
STRATZ_BASE_URL=https://api.stratz.com/graphql
# Canonical name. STRATZ_API_KEY is read only as a local fallback.
STRATZ_API_TOKEN=
STRATZ_USER_AGENT=STRATZ_API
STRATZ_TIMEOUT_SECONDS=20
STRATZ_MAX_RETRIES=3
STRATZ_MAX_HISTORY_PAGES=25
DATABASE_URL=postgresql+psycopg://dota:dota@localhost:5432/dota_report_card
REDIS_URL=redis://localhost:6379/0

# Tracker worker admission and backpressure.
# Shared by all replicas using the same provider credentials.
TRACKER_NAMESPACE=tracker
TRACKER_P1_DEPTH_LIMIT=100
TRACKER_P1_AGE_SECONDS=60
TRACKER_QUOTA_UTILIZATION_LIMIT=0.8
TRACKER_P2_PRESSURE_INTERVAL_SECONDS=5
TRACKER_REPLAY_DELAY_SECONDS=360

# Tracker identity (mobile API). Empty values keep the related routes fail-closed (503).
TRACKER_APPLE_AUDIENCE=
TRACKER_GOOGLE_AUDIENCE=
TRACKER_STEAM_CALLBACK_URL=
# App Store JWS verification: a pinned Apple root certificate file and the app bundle id.
TRACKER_APP_STORE_ROOT_CERT_PATH=
TRACKER_APP_STORE_BUNDLE_ID=
TRACKER_APP_STORE_ENVIRONMENTS=Production
# Separately authenticated operations readout at /internal/tracker (503 when empty).
TRACKER_INTERNAL_TOKEN=
# Pro historical depth ceiling in days. Open owner decision: empty = no Pro backfill.
TRACKER_PRO_HISTORY_DAYS=
