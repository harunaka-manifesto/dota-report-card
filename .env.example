# Local defaults. Production must override the deployment-critical values.
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
OPENDOTA_SOURCE=fixture
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
STEAM_API_KEY=
OPENDOTA_FIXTURE_DIR=tests/fixtures/opendota
DATABASE_URL=postgresql+psycopg://dota:dota@localhost:5432/dota_report_card
REDIS_URL=redis://localhost:6379/0
MODEL_VERSION=free-dna-model-5.2.0
TEMPLATE_VERSION=templates-1.0.0
ROLE_CONFIDENCE_THRESHOLD=0.60
SUMMARY_COVERAGE_THRESHOLD=0.60
REPLAY_COVERAGE_THRESHOLD=0.60
ANALYSIS_MAX_CONCURRENCY=4
OPENDOTA_MAX_RETRIES=3
OPENDOTA_TIMEOUT_SECONDS=15
FREE_HISTORY_LIMIT=
MAX_DEEP_MATCHES=25
MAX_PARSE_REQUESTS=0
MAX_DATA_COST_PER_REPORT=50
MIN_MARGINAL_INFORMATION_GAIN=0.05
MAX_PRIMARY_HYPOTHESES=3
SESSION_GAP_MINUTES=90
DEFAULT_ANALYSIS_MODE=free
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_BACKEND=auto
ANALYSIS_EXECUTION_BACKEND=auto

FREE_DNA_V6_ENABLED=false

FREE_DNA_V61_ENABLED=false
FREE_DNA_V61_SHADOW_ENABLED=false
FREE_DNA_V61_EXPERIMENTAL_EVOLUTION_ENABLED=false
FREE_DNA_V61_EXPERIMENTAL_LOOPS_ENABLED=false
FREE_DNA_V61_ARTIFACT_DIR=
FREE_DNA_V61_BASELINE_ARTIFACT=
FREE_DNA_V61_THRESHOLD_ARTIFACT=
FREE_DNA_V61_SUMMARY_PRIOR_ARTIFACT=
FREE_DNA_V61_DISTANCE_ARTIFACT=
FREE_DNA_V61_SESSION_RELIABILITY_ARTIFACT=
FREE_DNA_V61_SEMANTIC_ARTIFACT=
FREE_DNA_V61_BUILD_MANIFEST=
FREE_DNA_V61_RELEASE_AUTHORIZATION=
FREE_DNA_V61_MODEL_VERSION=free-dna-model-6.1.0
FREE_DNA_V61_ANALYTICAL_SOURCE_SHA=

RELEASE_COMMIT_SHA=
RELEASE_WORKTREE_DIRTY=false
